# Configuração desta academia (Bushi Strategy). Copie este arquivo para ".env" para rodar local,
# e configure as mesmas variáveis no painel do Netlify (Site settings > Environment variables).
# Sem VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY o app não sobe — de propósito, para nunca
# conectar no banco de outra academia.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a "publishable key" (sb_publishable_...) do projeto — Project Settings > API Keys >
# "Publishable and secret API keys". A chave "anon" legada (eyJ...) também funciona aqui.
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-aqui

# Qual pasta de marcas/ usar (nome, ícones, logo, cores).
VITE_MARCA=bushistrategy
