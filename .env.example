# Configuração do Supabase desta academia. Copie este arquivo para ".env"
# (ou configure essas variáveis diretamente no painel do Netlify, em
# Site settings > Environment variables) e preencha com o projeto Supabase
# criado para essa academia específica.
#
# Se essas variáveis não forem definidas, o app usa o banco padrão da Cia
# Paulista (comportamento de hoje, sem quebrar nada).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
